        1
      ],
      "rows": 2,
      "spec": {
        "annotations": {
          "pl7.app/description": "Largest distance-to-centroid among the cluster's members — a compactness measure (0–1; smaller is tighter).",
          "pl7.app/format": ".2f",
          "pl7.app/label": "Cluster radius",
          "pl7.app/max": "1",
          "pl7.app/min": "0",
          "pl7.app/rankingOrder": "decreasing",
          "pl7.app/table/orderPriority": "2900",
          "pl7.app/table/visibility": "default",
          "pl7.app/trace": "[{\"importance\":30,\"label\":\"BLOSUM62, ident:0.8, cov:0.8\",\"type\":\"milaboratories.clonotype-clustering.clustering\"}]"
