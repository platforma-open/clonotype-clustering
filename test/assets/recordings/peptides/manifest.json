              "pl7.app/clustering/algorithm": "mmseqs2",
              "pl7.app/clustering/blockId": "{{blockId}}",
              "pl7.app/peptide/extractionRunId": "xsv-fixture"
            },
            "name": "pl7.app/clusterId",
            "type": "String"
          }
        ],
        "domain": {
          "pl7.app/alphabet": "aminoacid",
          "pl7.app/clustering/centroidAlignment": "auto",
          "pl7.app/clustering/gapThresholdPercent": "50",
          "pl7.app/clustering/residueWeighting": "equal",
          "pl7.app/clustering/sequenceContent": "referenceCentroid",
          "pl7.app/feature": "peptide"
        },
        "kind": "PColumn",
        "name": "pl7.app/sequence",
        "valueType": "String"
      }
    }
