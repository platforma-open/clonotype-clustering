    {
      "column": "sequence",
      "parentAxes": [
        1
      ],
      "rows": 2,
      "spec": {
        "annotations": {
          "pl7.app/description": "Per-column consensus of the cluster's aligned members (kalign MSA). May contain 'X' at low-confidence positions and need not match any observed member; distance-to-centroid and cluster radius are measured against it. Computed with the automatically chosen (ungapped for a peptide library whose sequences share one length, gapped otherwise) alignment model, equal residue weighting, gap threshold 50%. Consensus threshold 60%.",
          "pl7.app/label": "Theoretical Centroid Peptide sequence",
          "pl7.app/table/orderPriority": "4000",
          "pl7.app/table/visibility": "optional",
          "pl7.app/trace": "[{\"importance\":30,\"label\":\"BLOSUM62, ident:0.8, cov:0.8\",\"type\":\"milaboratories.clonotype-clustering.clustering\"}]"
        },
        "axesSpec": [
          {
            "annotations": {
              "pl7.app/label": "Cluster Id",
              "pl7.app/table/orderPriority": "990000",
              "pl7.app/table/visibility": "default"
            },
            "domain": {
              "pl7.app/clustering/algorithm": "mmseqs2",
              "pl7.app/clustering/blockId": "{{blockId}}",
              "pl7.app/peptide/extractionRunId": "xsv-fixture"
            },
            "name": "pl7.app/clusterId",
            "type": "String"
          }
        ],
        "domain": {
          "pl7.app/alphabet": "aminoacid",
          "pl7.app/clustering/centroidAlignment": "auto",
          "pl7.app/clustering/consensusThresholdPercent": "60",
          "pl7.app/clustering/gapThresholdPercent": "50",
          "pl7.app/clustering/residueWeighting": "equal",
          "pl7.app/clustering/sequenceContent": "centroid",
          "pl7.app/feature": "peptide"
        },
        "kind": "PColumn",
        "name": "pl7.app/sequence",
        "valueType": "String"
      }
    },
    {
      "column": "sequence_referenceCentroid",
      "parentAxes": [
        1
      ],
      "rows": 2,
      "spec": {
        "annotations": {
          "pl7.app/description": "The real cluster member closest to the theoretical centroid (the medoid). Made entirely of observed residues, so it is directly synthesizable. Computed with the automatically chosen (ungapped for a peptide library whose sequences share one length, gapped otherwise) alignment model, equal residue weighting, gap threshold 50%.",
          "pl7.app/label": "Reference Centroid Peptide sequence",
          "pl7.app/table/orderPriority": "4000",
          "pl7.app/table/visibility": "default",
          "pl7.app/trace": "[{\"importance\":30,\"label\":\"BLOSUM62, ident:0.8, cov:0.8\",\"type\":\"milaboratories.clonotype-clustering.clustering\"}]"
        },
